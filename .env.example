# Copy to backend/.env for local (non-Docker) runs. docker-compose.yml sets these for containers.

ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://taskmanager:taskmanager@localhost:5432/taskmanager
REDIS_URL=redis://localhost:6379/0

# Required in production: at least 32 characters.
JWT_SECRET=dev-only-secret-change-me-in-production!!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute          # per client IP on /auth/*
RATE_LIMIT_API=100/minute          # per user on everything else
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1   # defaults to REDIS_URL

# CELERY_BROKER_URL=redis://localhost:6379/0        # defaults to REDIS_URL
CELERY_TASK_ALWAYS_EAGER=false
EVENT_PUBLISH_TIMEOUT_SECONDS=2

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
