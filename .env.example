# Copy to backend/.env for local (non-Docker) runs. docker-compose.yml sets these for containers.

ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# Ports match the loopback mappings in docker-compose.yml (db: 55432, redis: 6380).
DATABASE_URL=postgresql+asyncpg://taskmanager:taskmanager@localhost:55432/taskmanager
REDIS_URL=redis://localhost:6380/0
SEED_DEMO_DATA=true

# Required in production: at least 32 characters.
JWT_SECRET=dev-only-secret-change-me-in-production!!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute          # per client IP on /auth/*
RATE_LIMIT_API=100/minute          # per user on everything else
# RATE_LIMIT_STORAGE_URI=redis://localhost:6380/1   # defaults to REDIS_URL

# CELERY_BROKER_URL=redis://localhost:6380/0        # defaults to REDIS_URL
CELERY_TASK_ALWAYS_EAGER=false
EVENT_PUBLISH_TIMEOUT_SECONDS=2

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# /docs, /redoc and /openapi.json. Unset: on everywhere except production (CR-012).
# API_DOCS_ENABLED=false
