    "/api/v1/tasks/{task_id}": {
      "delete": {
        "operationId": "delete_task_api_v1_tasks__task_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          },
          {
            "description": "IANA time zone (e.g. America/New_York) that defines the user's \"today\" for due dates. Defaults to UTC.",
            "in": "header",
            "name": "X-Timezone",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "IANA time zone (e.g. America/New_York) that defines the user's \"today\" for due dates. Defaults to UTC.",
              "title": "X-Timezone"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
